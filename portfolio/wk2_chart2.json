{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Devolved local authorities show more consistent productivity growth while non-devolved",
      "areas vary more"
    ],
    "subtitle": "Productivity (GVA per hour worked, \u00a3), 2004 vs 2023",
    "anchor": "start"
  },
  "data": {
    "url": "productivity_dumbbell.csv"
  },
  "width": 460,
  "height": {
    "step": 32
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "k": "\u25cb 2004\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u25b6 2023\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0% = growth 2004 to 2023"
          }
        ]
      },
      "mark": {
        "type": "text",
        "x": "width",
        "y": -6,
        "align": "right",
        "baseline": "bottom",
        "fontSize": 14,
        "color": "#555"
      },
      "encoding": {
        "text": {
          "field": "k"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "opacity": 0.85
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Rest of England, no mayor (pooled)",
            "West Northamptonshire",
            "Nottingham",
            "Cornwall",
            "Somerset",
            "North Yorkshire",
            "Buckinghamshire",
            "Six mayoral areas (pooled)",
            "Greater Manchester",
            "West Yorkshire",
            "South Yorkshire",
            "West Midlands",
            "Liverpool City Region",
            "Tees Valley"
          ],
          "axis": {
            "title": null,
            "ticks": false,
            "domain": false,
            "labelLimit": 260,
            "grid": true,
            "gridColor": "#ececec",
            "labelFontWeight": {
              "condition": {
                "test": "indexof(datum.label, 'pooled') >= 0",
                "value": 700
              },
              "value": 400
            },
            "labelExpr": "indexof(datum.label, 'Rest of England') == 0 ? ['Rest of England', 'non-devolved (pooled)'] : (indexof(datum.label, 'Six mayoral areas') == 0 ? ['Six mayoral areas', 'devolved (pooled)'] : datum.label)",
            "labelOffset": {
              "condition": {
                "test": "indexof(datum.label, '(pooled)') >= 0",
                "value": -8
              },
              "value": 0
            }
          }
        },
        "x": {
          "field": "prod_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              15,
              45
            ]
          },
          "axis": {
            "title": "Productivity: GVA per hour worked (\u00a3, current prices)",
            "grid": false
          }
        },
        "x2": {
          "field": "prod_end"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "No mayor",
              "Mayoral combined authority"
            ],
            "range": [
              "#888888",
              "#0072B2"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "symbolType": "stroke",
            "offset": 26
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "strokeWidth": 2,
        "fill": "white"
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Rest of England, no mayor (pooled)",
            "West Northamptonshire",
            "Nottingham",
