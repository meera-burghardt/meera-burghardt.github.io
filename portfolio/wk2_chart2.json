  "config": {
    "view": {
      "stroke": null
    },
    "padding": {
      "right": 5,
      "left": 5,
      "top": 5,
      "bottom": 5
    },
    "font": "Avenir Next, Avenir, Helvetica Neue, Helvetica, Arial, sans-serif",
    "title": {
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#333",
      "subtitleFontSize": 13,
