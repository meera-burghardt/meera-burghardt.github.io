        },
        "stroke": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "No mayor",
              "Mayoral combined authority"
            ],
            "range": [
              "#888888",
              "#0072B2"
            ]
          },
          "legend": null
        },
        "size": {
          "condition": {
            "test": "datum.pooled == 1",
