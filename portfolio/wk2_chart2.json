        "x": {
          "datum": 0,
          "scale": {
            "domain": [
              -1,
              3
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": "\u25cb 1998 to 2016    \u25b6 \u25c0 2016 to 2023    \u25b2 \u25bc growth faster / slower after"
          }
        ]
      },
      "mark": {
        "type": "text",
