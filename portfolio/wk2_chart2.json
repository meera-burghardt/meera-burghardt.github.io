    {
      "transform": [
        {
          "calculate": "max(datum.growth_pre, datum.growth_post)",
          "as": "xmax"
        },
        {
          "calculate": "(datum.change >= 0 ? '\u25b2 ' : '\u25bc ') + format(datum.change, '+.1f')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Six mayoral areas (pooled)",
