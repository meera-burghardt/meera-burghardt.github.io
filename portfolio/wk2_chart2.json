          },
          "value": "triangle-left"
        },
        "size": {
          "condition": {
            "test": "datum.pooled == 1",
            "value": 220
          },
          "value": 130
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "max(datum.prod_start, datum.prod_end)",
          "as": "xmax"
        },
        {
          "calculate": "format(datum.growth_pct, '+.0f') + '%'",
          "as": "lab"
        }
