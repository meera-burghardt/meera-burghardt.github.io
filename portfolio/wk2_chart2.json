            "domain": false,
            "labelLimit": 260,
            "grid": true,
            "gridColor": "#ececec",
            "labelFontWeight": {
              "condition": {
                "test": "indexof(['Six mayoral areas (pooled)','Rest of England, no mayor (pooled)'], datum.label) >= 0",
                "value": 700
              },
              "value": 400
            }
          }
        },
        "x": {
          "field": "growth_pre",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              3
            ]
          },
          "axis": {
            "title": "Average annual growth in real GDP per head (%)",
            "grid": false
          }
        },
        "x2": {
          "field": "growth_post"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Mayoral combined authority",
              "No mayor"
            ],
            "range": [
              "#0072B2",
              "#888888"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "symbolType": "stroke",
