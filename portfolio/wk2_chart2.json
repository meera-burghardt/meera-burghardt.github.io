            "Tees Valley"
          ],
          "axis": {
            "title": null,
            "ticks": false,
            "domain": false,
            "labelLimit": 260,
            "grid": true,
            "gridColor": "#ececec",
            "labelFontWeight": {
              "condition": {
                "test": "indexof(datum.label, 'pooled') >= 0",
