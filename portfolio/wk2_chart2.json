          "field": "xmax",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              3
            ]
          }
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.change >= 0",
            "value": "#00785C"
          },
          "value": "#C4410C"
        }
      }
    }
