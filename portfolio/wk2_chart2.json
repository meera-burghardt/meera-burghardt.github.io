{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "ADD YOUR TITLE",
    "subtitle": "ADD SUBTITLE: average annual real GDP per head growth (%), 1998-2016 vs 2016-2023, source (ONS)",
    "anchor": "start"
  },
  "data": {
    "url": "mayoral_growth.csv"
  },
  "width": 460,
  "height": {
    "step": 28
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#666"
      },
