            "range": [
              "#0072B2",
              "#888888"
            ]
          },
          "legend": null
        },
        "size": {
          "condition": {
            "test": "datum.pooled == 1",
            "value": 150
          },
          "value": 80
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Six mayoral areas (pooled)",
            "South Yorkshire",
            "Greater Manchester",
            "West Yorkshire",
            "Liverpool City Region",
            "West Midlands",
            "Tees Valley",
            "Rest of England, no mayor (pooled)",
