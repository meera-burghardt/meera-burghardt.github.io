            "Cornwall",
            "North Yorkshire",
            "Buckinghamshire",
            "West Northamptonshire",
            "Cheshire East"
          ]
        },
        "x": {
          "datum": 3,
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              3
            ]
          }
        },
        "text": {
          "field": "k"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "opacity": 0.85
