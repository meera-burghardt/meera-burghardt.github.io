          "condition": {
            "test": "datum.change >= 0",
            "value": "triangle-right"
          },
          "value": "triangle-left"
        },
        "size": {
          "condition": {
            "test": "datum.pooled == 1",
            "value": 220
          },
          "value": 130
        }
      }
