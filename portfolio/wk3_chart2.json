          "x2": {"value": 179},
          "y": {"value": 206},
          "y2": {"value": 220}
        }
      },
      {
        "transform": [{"filter": "datum.band == '-5% to 0%' && datum.panel == 'Loan of over 20% (London)'"}],
        "mark": {"type": "text", "text": "Repaid at a gain", "align": "left", "baseline": "middle", "fontSize": 13, "fontWeight": 500, "color": "#333333"},
        "encoding": {"x": {"value": 189}, "y": {"value": 213}}
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Inter, Helvetica Neue, Arial, sans-serif",
    "facet": {"spacing": 32}
  }
}